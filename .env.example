# PlayChess server environment.
# Copy to .env on the machine that runs the API. Never commit .env.
# Placeholder values below are valid for local checks and rejected in production.

NODE_ENV=development
DATABASE_URL=postgresql://playchess:change-me@postgres:5432/playchess
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars
WEB_ORIGIN=http://127.0.0.1:4317
API_HOST=0.0.0.0
API_PORT=4318
LOG_LEVEL=info

# Public client value. Safe to expose in the browser. Do not put secrets in VITE_ variables.
VITE_API_ORIGIN=http://127.0.0.1:4318
